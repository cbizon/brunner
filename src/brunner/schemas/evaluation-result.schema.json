{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brunner.dev/schemas/evaluation-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "summary",
    "metrics",
    "reports"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": ["complete", "failed"]
    },
    "summary": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          }
        }
      }
    },
    "error": {
      "type": "object"
    }
  }
}
