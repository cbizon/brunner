{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brunner.dev/schemas/assessment-common.schema.json",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "finding"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": ["string", "null"]
        },
        "finding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "rating",
        "confidence",
        "summary",
        "evidence"
      ],
      "properties": {
        "applicability": {
          "enum": ["applicable", "not_applicable", "uncertain"]
        },
        "rating": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "applicable"
              }
            },
            "required": ["applicability"]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
